# GenLayer RPC endpoint. Hosted Studio by default; use http://127.0.0.1:4000/api for a local Studio.
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Network shown in MetaMask
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Studio
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN

# Address printed by `genlayer deploy` for contracts/arbiter.py
NEXT_PUBLIC_CONTRACT_ADDRESS=
